CREATE TABLE CAR(
carid NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY ,
carname VARCHAR(50) CONSTRAINT CARNM_NN NOT NULL,
carprice NUMBER(30),
people NUMBER(3),
oil VARCHAR2(10),
color VARCHAR2(10),
distancy NUMBER(20),
endtime DATE,
locationX VARCHAR2(30),
locationY VARCHAR2(30),
filename VARCHAR2(30),
releasDate DATE DEFAULT SYSDATE );
