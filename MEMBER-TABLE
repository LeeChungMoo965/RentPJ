CREATE TABLE member ( 
    id VARCHAR2(10) ,
    password VARCHAR2(10) CONSTRAINT NN_PW_MEMBER NOT NULL, 
    name VARCHAR2(10) CONSTRAINT NN_NM_MEMBER NOT NULL,  
    gender VARCHAR2(8),
    birth VARCHAR2(10),
    mail VARCHAR2(30),
    phone VARCHAR2(20),
    address VARCHAR2(90),
    regist_day DATE DEFAULT SYSDATE, CONSTRAINT PK_ID_MEMBER PRIMARY KEY(id) 
);
