CREATE TABLE MEMBER (
    ID VARCHAR2(10),
    PASSWORD VARCHAR2(10) NOT NULL,
    NAME VARCHAR2(10) NOT NULL,
    GENDER VARCHAR2(8),
    BIRTH VARCHAR2(10),
    MAIL VARCHAR2(30),
    PHONE VARCHAR2(20),
    ADDRESS VARCHAR2(90),
    REGIST_DAY DATE DEFAULT SYSDATE,
    CONSTRAINT PK_ID_MEMBER PRIMARY KEY (ID)
);
