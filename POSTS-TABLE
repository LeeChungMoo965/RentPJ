CREATE TABLE posts (
    post_id NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY,
    title VARCHAR2(200)CONSTRAINT NN_POSTS_TITLE NOT NULL,
    content CLOB CONSTRAINT NN_POSTS_CONTENT NOT NULL,
    writer VARCHAR2(10) CONSTRAINT NN_POSTS_WRITER NOT NULL,
    created_date DATE DEFAULT SYSDATE,
    updated_date DATE,
    CONSTRAINT FK_POSTS_WRITER FOREIGN KEY(writer) REFERENCES member(id)
);
