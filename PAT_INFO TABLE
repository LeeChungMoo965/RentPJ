CREATE TABLE PAY_INFO (
    PAY_NUMBER NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY ,
    ID VARCHAR2(10) CONSTRAINT PI_ID_RT REFERENCES MEMBER (ID),
    carid NUMBER(10)CONSTRAINT PI_CARID_RT REFERENCES CAR (carid),
    total_price NUMBER(10),
    releasDate DATE DEFAULT SYSDATE
);
